# 可选。大模型 Key 请在应用「齿轮配置」里添加，不要写进本文件。
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 后端监听（默认本机）
# API_HOST=127.0.0.1
# API_PORT=8777

# Edge-TTS 默认音色；不填用晓晓
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 微软 TTS 不稳定时再设代理，例如 http://127.0.0.1:7890
# EDGE_TTS_PROXY=

# 模型商店自有 CDN（可选）。不填则走 hf-mirror
# KOUBO_CDN=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/koubo

# 后端日志：DEBUG / INFO / WARNING / ERROR；文件在 logs/server.log
# KOUBO_LOG_LEVEL=INFO
